{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": { "type": "array" }
            },
            "required": ["host"]
          }
        },
        "tls": { "type": "array" }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "capabilities": { "type": "object" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer" },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "runAsGroup": { "type": "integer" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "fsGroup": { "type": "integer" },
        "runAsUser": { "type": "integer" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsGroup": { "type": "integer" }
      }
    },
    "primeagent": {
      "type": "object",
      "properties": {
        "global": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "tag": { "type": "string" }
              }
            }
          }
        },
        "backend": {
          "type": "object",
          "properties": {
            "replicaCount": { "type": "integer" },
            "backendOnly": { "type": "boolean" },
            "numWorkers": { "type": "integer" },
            "command": {
              "type": "array",
              "items": { "type": "string" }
            },
            "service": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "port": { "type": "integer" }
              }
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string" },
                "imagePullPolicy": { "type": "string" },
                "tag": { "type": "string" }
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "requests": { "type": "object" },
                "limits": { "type": "object" }
              }
            },
            "probe": {
              "type": "object",
              "properties": {
                "failureThreshold": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" },
                "initialDelaySeconds": { "type": "integer" }
              }
            },
            "env": { "type": "array" },
            "sqlite": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "volume": {
                  "type": "object",
                  "properties": {
                    "size": { "type": "string" },
                    "mountPath": { "type": "string" },
                    "existingStorageClassName": { "type": "string" },
                    "storageClass": { "type": "object" }
                  }
                }
              }
            },
            "externalDatabase": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "nodeSelector": { "type": "object" },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object" },
            "podAnnotations": { "type": "object" }
          }
        },
        "frontend": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "replicaCount": { "type": "integer" },
            "service": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "port": { "type": "integer" }
              }
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string" },
                "imagePullPolicy": { "type": "string" },
                "tag": { "type": "string" }
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "requests": { "type": "object" },
                "limits": { "type": "object" }
              }
            },
            "probe": {
              "type": "object",
              "properties": {
                "failureThreshold": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" },
                "initialDelaySeconds": { "type": "integer" }
              }
            },
            "nodeSelector": { "type": "object" },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object" },
            "podAnnotations": { "type": "object" }
          }
        }
      }
    },
    "secretProvider": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
